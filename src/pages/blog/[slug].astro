---
import { getCollection, getEntries, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { blogCategoryLabels } from '../../data/blogCategories';
import { formatDate } from '../../lib/formatDate';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const relatedEpisodes = post.data.relatedEpisodes?.length
  ? await getEntries(post.data.relatedEpisodes)
  : [];

---

<Layout
  title={`${post.data.title} - Entwicklungszeit Blog`}
  description={post.data.description}
>
  <Header />
  <main id="main-content">
    <article class="pt-32 sm:pt-40 pb-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <a
          href={`/blog/kategorie/${post.data.category}`}
          class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary mb-6 hover:bg-primary/20 transition-colors duration-300"
        >
          {blogCategoryLabels[post.data.category]}
        </a>

        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 leading-tight">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-10">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <span>
                (aktualisiert am {formatDate(post.data.updatedDate)})
              </span>
            )
          }
        </div>

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

        {
          relatedEpisodes.length > 0 && (
            <div class="mt-16 pt-8 border-t border-gray-200">
              <h2 class="text-xl font-semibold text-gray-900 mb-4">
                Passende Podcast-Folgen
              </h2>
              <ul class="space-y-2">
                {relatedEpisodes.map(episode => (
                  <li>
                    <a
                      href={`/podcast/${episode.id}`}
                      class="text-primary font-medium hover:text-secondary transition-colors duration-300"
                    >
                      {episode.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="mt-16">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-primary font-medium hover:text-secondary transition-colors duration-300"
          >
            ← Zurück zum Blog
          </a>
        </p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
