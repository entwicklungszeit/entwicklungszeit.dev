---
import { getCollection } from 'astro:content';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Layout from '../../../layouts/Layout.astro';
import { blogCategories, blogCategoryLabels, blogCategoryTextClass, type BlogCategory } from '../../../data/blogCategories';
import { formatDate } from '../../../lib/formatDate';

export async function getStaticPaths() {
  return blogCategories.map(category => ({ params: { category } }));
}

const { category } = Astro.params as { category: BlogCategory };

const posts = (await getCollection('blog', ({ data }) => data.status === 'public' && data.category === category)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categoryLabel = blogCategoryLabels[category];
---

<Layout
  title={`${categoryLabel} Artikel - Entwicklungszeit Blog`}
  description={`Alle Blog-Artikel aus der Kategorie ${categoryLabel} auf Entwicklungszeit.`}
>
  <Header />
  <main id="main-content" class="pt-16">
    <section class="bg-paper py-16 sm:py-20">
      <div class="max-w-wrap mx-auto px-6 sm:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
          Blog-Kategorie
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-normal text-ink mb-10">{categoryLabel}</h1>

        <nav class="flex flex-wrap gap-x-6 gap-y-2 border-b border-rule pb-4 mb-12" aria-label="Kategorie-Filter">
          <a href="/blog" class="text-sm font-medium text-ink-soft hover:text-ink transition-colors duration-300">
            Alle
          </a>
          {
            blogCategories.map(item => (
              <a
                href={`/blog/kategorie/${item}`}
                class:list={[
                  'text-sm transition-colors duration-300',
                  item === category
                    ? 'font-semibold text-ink border-b-2 border-primary pb-1 -mb-[17px]'
                    : 'font-medium text-ink-soft hover:text-ink'
                ]}
              >
                {blogCategoryLabels[item]}
              </a>
            ))
          }
        </nav>

        {
          posts.length === 0 ? (
            <p class="text-ink-soft">Noch keine Artikel in dieser Kategorie.</p>
          ) : (
            <ul class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
              {posts.map(post => (
                <li class="border-t border-rule pt-6">
                  <p class={`text-xs font-bold uppercase tracking-[0.06em] mb-3 ${blogCategoryTextClass[post.data.category]}`}>
                    {blogCategoryLabels[post.data.category]}
                  </p>
                  <h2 class="font-serif text-2xl font-normal leading-snug text-ink mb-3">
                    <a href={`/blog/${post.id}`} class="hover:text-primary transition-colors duration-300">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-sm leading-relaxed text-ink-soft mb-4">{post.data.description}</p>
                  <time datetime={post.data.pubDate.toISOString()} class="text-xs text-ink-faint">
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
