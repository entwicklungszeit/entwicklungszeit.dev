---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { blogCategories, blogCategoryLabels, blogCategoryTextClass } from '../../data/blogCategories';
import { formatDate } from '../../lib/formatDate';

const posts = (await getCollection('blog', ({ data }) => data.status === 'public')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog - Entwicklungszeit"
  description="Artikel über Kommunikation, Führung, AI Engineering und Angular von Gregor Woiwode."
>
  <Header />
  <main id="main-content" class="pt-16">
    <section class="bg-paper py-16 sm:py-20">
      <div class="max-w-wrap mx-auto px-6 sm:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
          Artikel
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-normal text-ink mb-6">Blog</h1>
        <p class="text-lg leading-relaxed text-ink-soft max-w-[52ch] mb-10">
          Kommunikation, Führung, AI Engineering und Angular – praxisnahe Artikel für
          Softwareentwickler und Tech Leads.
        </p>

        <nav class="flex flex-wrap gap-x-6 gap-y-2 border-b border-rule pb-4 mb-12" aria-label="Kategorie-Filter">
          <a href="/blog" class="text-sm font-semibold text-ink border-b-2 border-primary pb-1 -mb-[17px]">
            Alle
          </a>
          {
            blogCategories.map(category => (
              <a
                href={`/blog/kategorie/${category}`}
                class="text-sm font-medium text-ink-soft hover:text-ink transition-colors duration-300"
              >
                {blogCategoryLabels[category]}
              </a>
            ))
          }
        </nav>

        {
          posts.length === 0 ? (
            <p class="text-ink-soft">Noch keine Artikel veröffentlicht.</p>
          ) : (
            <ul class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
              {posts.map(post => (
                <li class="border-t border-rule pt-6">
                  <p class={`text-xs font-bold uppercase tracking-[0.06em] mb-3 ${blogCategoryTextClass[post.data.category]}`}>
                    {blogCategoryLabels[post.data.category]}
                  </p>
                  <h2 class="font-serif text-2xl font-normal leading-snug text-ink mb-3">
                    <a href={`/blog/${post.id}`} class="hover:text-primary transition-colors duration-300">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-sm leading-relaxed text-ink-soft mb-4">{post.data.description}</p>
                  <time datetime={post.data.pubDate.toISOString()} class="text-xs text-ink-faint">
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
