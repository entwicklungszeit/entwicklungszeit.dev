---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Heading from '../../components/Heading.astro';
import Section from '../../components/ui/Section.astro';
import Layout from '../../layouts/Layout.astro';
import { blogCategories, blogCategoryLabels } from '../../data/blogCategories';
import { formatDate } from '../../lib/formatDate';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog - Entwicklungszeit"
  description="Artikel über Kommunikation, Führung, AI Engineering und Angular von Gregor Woiwode."
>
  <Header />
  <main id="main-content">
    <Section id="blog" background="white" class="pt-32 sm:pt-40">
      <div class="max-w-5xl mx-auto">
        <Heading title="Blog" subheading="Artikel" />
        <p class="text-lg text-gray-700 max-w-2xl mb-10">
          Kommunikation, Führung, AI Engineering und Angular – praxisnahe
          Artikel für Softwareentwickler und Tech Leads.
        </p>

        <div class="flex flex-wrap gap-3 mb-12" aria-label="Kategorie-Filter">
          <a
            href="/blog"
            class="px-4 py-2 rounded-full text-sm font-medium bg-primary text-white transition-colors duration-300"
          >
            Alle
          </a>
          {
            blogCategories.map(category => (
              <a
                href={`/blog/kategorie/${category}`}
                class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors duration-300"
              >
                {blogCategoryLabels[category]}
              </a>
            ))
          }
        </div>

        {
          posts.length === 0 ? (
            <p class="text-gray-500">Noch keine Artikel veröffentlicht.</p>
          ) : (
            <ul class="grid gap-8 sm:grid-cols-2">
              {posts.map(post => (
                <li class="bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-300 p-6 flex flex-col">
                  <span class="inline-block self-start px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary mb-4">
                    {blogCategoryLabels[post.data.category]}
                  </span>
                  <h2 class="text-xl font-semibold text-gray-900 mb-2">
                    <a href={`/blog/${post.id}`} class="hover:text-primary transition-colors duration-300">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-gray-600 mb-4 flex-1">{post.data.description}</p>
                  <time datetime={post.data.pubDate.toISOString()} class="text-sm text-gray-400">
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </Section>
  </main>
  <Footer />
</Layout>
