---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../lib/formatDate';

const episodes = (await getCollection('podcast')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Podcast - Entwicklungszeit"
  description="Alle Folgen des Entwicklungszeit Podcasts mit Shownotes: Softwareentwicklung, Führung und Kommunikation."
>
  <Header />
  <main id="main-content" class="pt-16">
    <section class="bg-paper py-16 sm:py-20">
      <div class="max-w-wrap mx-auto px-6 sm:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
          Alle Folgen
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-normal text-ink mb-6">Podcast</h1>
        <p class="text-lg leading-relaxed text-ink-soft max-w-[52ch] mb-12">
          Alle Folgen mit Shownotes. Die komplette Historie findest du außerdem auf Spotify,
          Apple Podcasts und YouTube.
        </p>

        {
          episodes.length === 0 ? (
            <p class="text-ink-soft">Noch keine redaktionellen Episodenseiten veröffentlicht.</p>
          ) : (
            <div class="border-t border-rule">
              {episodes.map(episode => (
                <a
                  href={`/podcast/${episode.id}`}
                  class="flex items-baseline gap-5 sm:gap-7 py-6 border-b border-rule group"
                >
                  <span class="font-serif text-2xl sm:text-3xl text-ink-faint w-10 sm:w-12 flex-shrink-0">
                    {String(episode.data.episodeNumber).padStart(2, '0')}
                  </span>
                  <div class="flex-1 min-w-0">
                    <h2 class="font-serif text-lg sm:text-xl font-normal text-ink mb-1 group-hover:text-primary transition-colors duration-300">
                      {episode.data.title}
                    </h2>
                    <p class="text-xs sm:text-sm text-ink-soft">
                      {formatDate(episode.data.pubDate)}
                      {episode.data.guest && <> · mit {episode.data.guest}</>}
                    </p>
                  </div>
                  <span class="hidden sm:inline text-sm font-semibold text-primary flex-shrink-0">
                    Shownotes →
                  </span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
