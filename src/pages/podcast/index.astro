---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import PodcastEpisodeList from '../../components/PodcastEpisodeList.vue';

// Der RSS-Feed liefert die Folgen; die Collection ergänzt Shownotes-Seiten.
// Verknüpfung über den Veröffentlichungstag (die meisten Feed-Items haben kein <itunes:episode>).
const shownotes = Object.fromEntries(
  (await getCollection('podcast')).map(e => [e.data.pubDate.toISOString().slice(0, 10), e.id])
);
---

<Layout
  title="Podcast - Entwicklungszeit"
  description="Alle Folgen des Entwicklungszeit Podcasts mit Shownotes: Softwareentwicklung, Führung und Kommunikation."
>
  <Header />
  <main id="main-content" class="pt-16">
    <section class="bg-paper py-16 sm:py-20">
      <div class="max-w-wrap mx-auto px-6 sm:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
          Alle Folgen
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-normal text-ink mb-6">Podcast</h1>
        <p class="text-lg leading-relaxed text-ink-soft max-w-[52ch] mb-12">
          Alle Folgen direkt aus dem Podcast-Feed. Wo es Shownotes gibt, sind sie verlinkt. Du
          findest den Podcast außerdem auf Spotify, Apple Podcasts und YouTube.
        </p>

        <PodcastEpisodeList client:load shownotes={shownotes} />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
