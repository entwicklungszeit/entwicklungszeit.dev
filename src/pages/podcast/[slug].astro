---
import { getCollection, getEntries, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../lib/formatDate';

export async function getStaticPaths() {
  const episodes = await getCollection('podcast');
  return episodes.map(episode => ({
    params: { slug: episode.id },
    props: { episode }
  }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);

const relatedPosts = episode.data.relatedPosts?.length
  ? await getEntries(episode.data.relatedPosts)
  : [];

---

<Layout
  title={`${episode.data.title} - Entwicklungszeit Podcast`}
  description={`Shownotes zu Folge ${episode.data.episodeNumber}: ${episode.data.title}`}
>
  <Header />
  <main id="main-content">
    <article class="pt-32 sm:pt-40 pb-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary mb-6">
          Folge {episode.data.episodeNumber}
        </span>

        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 leading-tight">
          {episode.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-6">
          <time datetime={episode.data.pubDate.toISOString()}>
            {formatDate(episode.data.pubDate)}
          </time>
          {episode.data.guest && <span>· mit {episode.data.guest}</span>}
        </div>

        <div class="flex flex-wrap gap-3 mb-10">
          {
            episode.data.audioUrl && (
              <a
                href={episode.data.audioUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white text-gray-700 font-medium rounded-lg shadow-sm hover:shadow-md border border-gray-200 transition-all duration-300 text-sm"
              >
                🎧 Anhören
              </a>
            )
          }
          {
            episode.data.youtubeUrl && (
              <a
                href={episode.data.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white text-gray-700 font-medium rounded-lg shadow-sm hover:shadow-md border border-gray-200 transition-all duration-300 text-sm"
              >
                ▶ Auf YouTube ansehen
              </a>
            )
          }
        </div>

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

        {
          relatedPosts.length > 0 && (
            <div class="mt-16 pt-8 border-t border-gray-200">
              <h2 class="text-xl font-semibold text-gray-900 mb-4">
                Passende Blog-Artikel
              </h2>
              <ul class="space-y-2">
                {relatedPosts.map(post => (
                  <li>
                    <a
                      href={`/blog/${post.id}`}
                      class="text-primary font-medium hover:text-secondary transition-colors duration-300"
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="mt-16">
          <a
            href="/podcast"
            class="inline-flex items-center gap-2 text-primary font-medium hover:text-secondary transition-colors duration-300"
          >
            ← Zurück zur Episodenübersicht
          </a>
        </p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
