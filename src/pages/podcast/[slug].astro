---
import { getCollection, getEntries, render } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../lib/formatDate';

export async function getStaticPaths() {
  const episodes = await getCollection('podcast');
  return episodes.map(episode => ({
    params: { slug: episode.id },
    props: { episode }
  }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);

const relatedPosts = episode.data.relatedPosts?.length
  ? await getEntries(episode.data.relatedPosts)
  : [];
---

<Layout
  title={`${episode.data.title} - Entwicklungszeit Podcast`}
  description={`Shownotes zu Folge ${episode.data.episodeNumber}: ${episode.data.title}`}
>
  <Header />
  <main id="main-content" class="pt-16">
    <article class="bg-paper py-16 sm:py-20">
      <div class="max-w-reading mx-auto px-6 sm:px-10">
        <span class="font-serif text-3xl text-ink-faint">
          {String(episode.data.episodeNumber).padStart(2, '0')}
        </span>

        <h1 class="font-serif text-3xl sm:text-4xl font-normal leading-[1.15] text-ink mt-2 mb-4">
          {episode.data.title}
        </h1>

        <p class="text-sm text-ink-soft mb-8">
          {formatDate(episode.data.pubDate)}
          {episode.data.guest && <> · mit {episode.data.guest}</>}
        </p>

        <div class="flex flex-wrap gap-3 mb-10 pb-10 border-b border-rule">
          {
            episode.data.audioUrl && (
              <a
                href={episode.data.audioUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-paper-raised text-ink font-medium rounded-sm border border-rule hover:border-ink-faint transition-colors duration-300 text-sm"
              >
                🎧 Anhören
              </a>
            )
          }
          {
            episode.data.youtubeUrl && (
              <a
                href={episode.data.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-paper-raised text-ink font-medium rounded-sm border border-rule hover:border-ink-faint transition-colors duration-300 text-sm"
              >
                ▶ Auf YouTube
              </a>
            )
          }
        </div>

        <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:font-normal prose-headings:text-ink prose-p:text-ink-soft prose-li:text-ink-soft prose-strong:text-ink prose-a:text-primary">
          <Content />
        </div>

        {
          relatedPosts.length > 0 && (
            <div class="mt-16 bg-paper-raised border border-rule rounded-sm p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-3">
                Passender Blog-Artikel
              </p>
              <ul class="space-y-2">
                {relatedPosts.map(post => (
                  <li>
                    <a
                      href={`/blog/${post.id}`}
                      class="font-serif text-lg text-ink hover:text-primary transition-colors duration-300"
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="mt-16">
          <a
            href="/podcast"
            class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-secondary transition-colors duration-300"
          >
            ← Zurück zur Episodenübersicht
          </a>
        </p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
