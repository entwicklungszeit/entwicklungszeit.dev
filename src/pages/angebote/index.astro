---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import OfferIcon from '../../components/OfferIcon.astro';
import { angebotePage } from '../../data/jsonld/angebote-jsonld';
import { offerNavItem } from '../../data/navigation';

const sections = [
  {
    heading: 'Kostenlose Inhalte',
    offers: [
      {
        ...offerNavItem('/podcast'),
        text: 'Gespräche über Kommunikation, Führung und den KI-Wandel in der Softwareentwicklung. Für Entwickler:innen und Tech Leads.'
      },
      {
        ...offerNavItem('/blog'),
        text: 'Artikel zu Softwareentwicklung, Angular, AI Engineering und Zusammenarbeit im Team.'
      }
    ]
  },
  {
    heading: 'Dienstleistungen',
    offers: [
      {
        ...offerNavItem('/angebote/entwickler-mit-wirkung'),
        kicker: '12 Wochen 1:1',
        text: 'Mentoring und Coaching für Entwickler:innen, die Wirkung, Gehalt oder Umsatz auf das nächste Level bringen wollen.'
      },
      {
        ...offerNavItem('/angebote/sparring'),
        kicker: 'Auf Stundenbasis',
        text: 'Ein Sparringspartner mit Erfahrung für Veränderungen in System, Architektur, Technologie oder Team. Die erste Stunde ist kostenfrei.'
      }
    ]
  }
];

const { title, description, schema } = angebotePage;
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="main-content" class="pt-16">
    <section class="bg-paper pt-12 pb-16 sm:pt-20 sm:pb-24">
      <div class="max-w-wrap mx-auto px-6 sm:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
          Angebote
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-normal leading-[1.1] text-ink mb-12 max-w-[22ch]">
          Was ich anbiete.
        </h1>
        {
          sections.map(section => (
            <div class="border-t border-rule pt-10 mb-16 last:mb-0">
              <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-8">
                {section.heading}
              </h2>
              <ul class="grid gap-8 md:grid-cols-2">
                {section.offers.map(offer => (
                  <li>
                    <a href={offer.href} class="group block">
                      {offer.icon && <OfferIcon offer={offer.icon} size={48} class="text-ink mb-5" />}
                      {'kicker' in offer && (
                        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-primary mb-2">
                          {offer.kicker}
                        </p>
                      )}
                      <h3 class="font-serif text-2xl text-ink mb-3 group-hover:text-primary transition-colors duration-300">
                        {offer.label}
                      </h3>
                      <p class="text-sm text-ink-soft leading-relaxed">{offer.text}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
