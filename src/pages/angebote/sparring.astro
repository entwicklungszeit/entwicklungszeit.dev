---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BeratungDetailsSection from '../../components/BeratungDetailsSection.astro';
import BeratungHeroSection from '../../components/BeratungHeroSection.astro';
import { discoveryCallUrl } from '../../data/angebote';
import { beratungPage } from '../../data/jsonld/beratung-jsonld';
import Layout from '../../layouts/Layout.astro';

const { title, description, schema } = beratungPage;
---

<Layout title={title} description={description} schema={schema}>
  <Header ctaLabel="Beratung anfragen" ctaHref={discoveryCallUrl} />
  <main id="main-content" class="pt-16">
    <BeratungHeroSection />
    <BeratungDetailsSection />
  </main>
  <Footer />
</Layout>
