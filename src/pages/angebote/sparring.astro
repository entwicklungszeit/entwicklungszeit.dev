---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SparringDetailsSection from '../../components/SparringDetailsSection.astro';
import SparringHeroSection from '../../components/SparringHeroSection.astro';
import { discoveryCallUrl } from '../../data/angebote';
import { sparringPage } from '../../data/jsonld/sparring-jsonld';
import Layout from '../../layouts/Layout.astro';

const { title, description, schema } = sparringPage;
---

<Layout title={title} description={description} schema={schema}>
  <Header ctaLabel="Sparring anfragen" ctaHref={discoveryCallUrl} />
  <main id="main-content" class="pt-16">
    <SparringHeroSection />
    <SparringDetailsSection />
  </main>
  <Footer />
</Layout>
