---
import CoachingContactCTA from '../../components/CoachingContactCTA.astro';
import CoachingFieldsSection from '../../components/CoachingFieldsSection.astro';
import CoachingHeroSection from '../../components/CoachingHeroSection.astro';
import CoachingPathsSection from '../../components/CoachingPathsSection.astro';
import CoachingPositioningSection from '../../components/CoachingPositioningSection.astro';
import CoachingSection from '../../components/CoachingSection.astro';
import CoachingTermsSection from '../../components/CoachingTermsSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TestimonialsSection from '../../components/TestimonialsSection.astro';
import { discoveryCallUrl } from '../../data/coaching';
import { entwicklerMitWirkungPage } from '../../data/jsonld/entwickler-mit-wirkung-jsonld';
import Layout from '../../layouts/Layout.astro';

const { title, description, schema } = entwicklerMitWirkungPage;
---

<Layout title={title} description={description} schema={schema}>
  <Header ctaLabel="Kennenlerngespräch buchen" ctaHref={discoveryCallUrl} />
  <main id="main-content" class="pt-16">
    <CoachingHeroSection />
    <CoachingPathsSection />
    <CoachingFieldsSection />
    <CoachingPositioningSection />
    <CoachingSection />
    <TestimonialsSection />
    <CoachingTermsSection />
    <CoachingContactCTA />
    <FaqSection />
    <CoachingContactCTA id="coaching-contact-faq" />
  </main>
  <Footer />
</Layout>
