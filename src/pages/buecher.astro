---
import { Image } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { books } from '../data/books';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Bücher von Gregor Woiwode - Angular, Softwarequalität und Windows Phone"
  description="Gregor Woiwode ist Autor von vier Fachbüchern: Angular, agile Qualitätssicherung und App-Entwicklung für Windows Phone. Mit Links zu Amazon und Medimops."
>
  <Header />
  <main id="main-content" class="pt-16 bg-paper">
    <section class="pt-12 pb-12 sm:pt-16 sm:pb-16">
      <div class="max-w-wrap mx-auto px-6 sm:px-10 flex flex-col gap-6">
        <a
          href="/"
          class="self-start text-sm text-ink-soft underline decoration-rule underline-offset-4 hover:text-primary hover:decoration-primary"
        >
          ← Zurück zur Startseite
        </a>
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">
          Bücher
        </p>
        <h1
          class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.1] tracking-tight text-ink max-w-[18ch]"
        >
          Vier Bücher, aus der <em class="italic text-primary">Praxis</em> geschrieben.
        </h1>
        <p class="text-xl leading-snug text-ink max-w-[56ch]">
          Ich schreibe Bücher, um komplizierte Themen so lange zu durchdringen, bis sie für jeden
          zugänglich sind – und dauerhaft im Kopf bleiben.
        </p>
        <p class="text-lg leading-relaxed text-ink-soft max-w-[56ch]">
          Dafür beschäftige ich mich über einen langen Zeitraum intensiv mit einer Sache und bereite
          sie systematisch auf. Wenn ich die Zielgruppe genau kenne, gelingt es mir, Inhalte so
          einfach zu vermitteln, dass sie wirklich verinnerlicht werden. Es geht dabei nicht darum,
          Bücher zu verkaufen – manche sind inzwischen ziemlich alt. Sie zeigen, wie ich arbeite:
          von Angular über agile Qualitätssicherung bis zur App-Entwicklung für Windows Phone.
        </p>
      </div>
    </section>

    <section class="pb-16 sm:pb-24">
      <ul class="max-w-wrap mx-auto px-6 sm:px-10 border-t border-rule">
        {
          books.map(book => (
            <li class="grid gap-8 sm:grid-cols-[220px_minmax(0,1fr)] sm:gap-14 py-10 sm:py-12 border-b border-rule">
              <Image
                src={book.cover}
                alt={`Buchcover: ${book.title}`}
                width={220}
                class="w-40 sm:w-[220px] h-auto rounded-[3px] shadow-[0_1px_2px_rgba(21,24,31,0.2),6px_10px_24px_rgba(21,24,31,0.22)]"
              />
              <div class="flex flex-col gap-3.5 max-w-[640px]">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint">
                  {book.topic}
                </p>
                <h2 class="font-serif text-3xl sm:text-4xl font-normal leading-[1.1] tracking-tight text-ink">
                  {book.title}
                </h2>
                <p class="text-base leading-normal text-ink-soft">{book.subtitle}</p>
                <p class="text-[17px] leading-[1.65] text-ink mt-1">{book.description}</p>
                {book.coauthors && (
                  <p class="text-sm text-ink-soft">Gemeinsam geschrieben mit {book.coauthors}.</p>
                )}
                <div class="flex flex-wrap items-center gap-x-7 gap-y-3 mt-2.5">
                  <a
                    href={book.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2.5 min-h-12 px-[22px] rounded-md bg-primary text-white text-[15px] font-semibold hover:bg-primary-dark focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-primary-light transition-colors"
                  >
                    Bei {book.shop} ansehen
                    <svg
                      aria-hidden="true"
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 10L10 4M5 4h5v5" />
                    </svg>
                  </a>
                  {book.review && (
                    <a
                      href={book.review.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[15px] font-medium text-ink underline decoration-rule underline-offset-4 hover:text-primary hover:decoration-primary"
                    >
                      {book.review.label} ↗
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
