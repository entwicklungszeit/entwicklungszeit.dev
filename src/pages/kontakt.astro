---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt - Entwicklungszeit"
  description="Du hast Fragen zum Podcast, einem Artikel oder zum Coaching? Schreib mir eine Nachricht."
>
  <Header />
  <main id="main-content" class="pt-16">
    <section class="bg-paper py-16 sm:py-24">
      <div class="max-w-wrap mx-auto px-6 sm:px-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
            Kontakt
          </p>
          <h1 class="font-serif text-4xl sm:text-5xl font-normal leading-[1.1] text-ink mb-6 max-w-[14ch]">
            Schreib mir – ich melde mich zurück.
          </h1>
          <p class="text-lg leading-relaxed text-ink-soft max-w-[46ch] mb-10">
            Ob Frage zum Coaching, ein Thema für den Podcast oder einfach Feedback zu einem
            Artikel – kurz per Formular oder direkt per Mail.
          </p>

          <div class="border-t border-rule pt-8">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-4">
              Social
            </p>
            <ul class="flex gap-6 text-sm font-semibold text-primary">
              <li>
                <a
                  href="https://www.linkedin.com/in/gregor-woiwode/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-secondary transition-colors duration-300"
                >
                  LinkedIn
                </a>
              </li>
              <li>
                <a
                  href="https://github.com/GregOnNet"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-secondary transition-colors duration-300"
                >
                  GitHub
                </a>
              </li>
              <li>
                <a
                  href="https://www.youtube.com/@entwicklungszeit"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-secondary transition-colors duration-300"
                >
                  YouTube
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="bg-paper-raised border border-rule rounded-sm p-8 sm:p-10">
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="betreff"
            class="space-y-6"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>
                Betreff: <input name="betreff" />
              </label>
            </p>

            <div>
              <label for="name" class="block text-sm font-semibold text-ink mb-2">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 bg-paper border border-rule rounded-sm text-ink placeholder-ink-faint focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-colors duration-300"
                placeholder="Dein Name"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-ink mb-2">
                E-Mail
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-paper border border-rule rounded-sm text-ink placeholder-ink-faint focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-colors duration-300"
                placeholder="deine@email.de"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-ink mb-2">
                Nachricht
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 bg-paper border border-rule rounded-sm text-ink placeholder-ink-faint focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none transition-colors duration-300"
                placeholder="Worum geht's?"></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                id="consent"
                name="consent"
                type="checkbox"
                required
                class="mt-1 h-4 w-4 text-primary focus:ring-primary border-rule rounded"
              />
              <label for="consent" class="text-sm text-ink-soft leading-relaxed">
                Ich stimme zu, dass meine Daten zur Kontaktaufnahme verarbeitet werden. Die
                Daten werden nur für die Beantwortung meiner Anfrage verwendet und nicht an
                Dritte weitergegeben. Weitere Informationen findest du in der
                <a href="/datenschutz" class="text-primary hover:text-secondary transition-colors duration-300">
                  Datenschutzerklärung
                </a>.
              </label>
            </div>

            <button
              type="submit"
              class="w-full inline-flex items-center justify-center px-6 py-3 bg-ink text-paper font-semibold rounded-sm hover:bg-ink/90 transition-colors duration-300"
            >
              Nachricht senden
            </button>

            <p class="text-xs text-ink-faint text-center">
              Ich antworte in der Regel innerhalb von 2 Werktagen.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
