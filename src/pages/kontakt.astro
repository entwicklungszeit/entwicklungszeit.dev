---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt - Entwicklungszeit"
  description="Du hast Fragen zum Podcast, einem Artikel oder zum Coaching? Schreib mir eine Nachricht."
>
  <Header />
  <main id="main-content" class="pt-32 sm:pt-40 pb-8">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Kontakt</h1>
      <p class="text-lg text-gray-600">
        Ob Frage, Feedback zu einer Folge oder Interesse an einer
        Zusammenarbeit – das Formular weiter unten kommt direkt bei mir an.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
