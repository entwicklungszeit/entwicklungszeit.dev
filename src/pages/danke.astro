---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Danke für deine Nachricht - Entwicklungszeit"
  description="Deine Nachricht ist angekommen. Ich melde mich schnellstmöglich zurück."
>
  <Header />
  <main id="main-content" class="pt-16">
    <section class="bg-paper py-16 sm:py-24">
      <div class="max-w-wrap mx-auto px-6 sm:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
          Kontakt
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-normal leading-[1.1] text-ink mb-6 max-w-[18ch]">
          Danke für deine Nachricht.
        </h1>
        <p class="text-lg leading-relaxed text-ink-soft max-w-[46ch] mb-10">
          Ich bearbeite sie und melde mich schnellstmöglich zurück.
        </p>
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 bg-ink text-paper font-semibold rounded-sm hover:bg-ink/90 transition-colors duration-300"
        >
          Zurück zur Startseite
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
