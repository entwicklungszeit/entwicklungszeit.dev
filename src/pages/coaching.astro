---
import BeforeAfterSection from '../components/BeforeAfterSection.astro';
import CoachingContactCTA from '../components/CoachingContactCTA.astro';
import CoachingHeroSection from '../components/CoachingHeroSection.astro';
import CoachingSection from '../components/CoachingSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Coaching - Impact Developer Programm mit Gregor Woiwode"
  description="1:1 Software Coaching für Entwickler auf dem Weg zu einem Jahresgehalt zwischen 80.000 und 200.000 Euro: technische und strategische Begleitung zum technischen Leader."
>
  <Header ctaLabel="Kennenlerngespräch buchen" ctaHref="/kontakt" />
  <main id="main-content" class="pt-16">
    <CoachingHeroSection />
    <BeforeAfterSection />
    <CoachingSection />
    <TestimonialsSection />
    <FaqSection />
    <CoachingContactCTA />
  </main>
  <Footer />
</Layout>
