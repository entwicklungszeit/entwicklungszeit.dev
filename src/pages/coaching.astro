---
import CoachingContactCTA from '../components/CoachingContactCTA.astro';
import CoachingFieldsSection from '../components/CoachingFieldsSection.astro';
import CoachingHeroSection from '../components/CoachingHeroSection.astro';
import CoachingPathsSection from '../components/CoachingPathsSection.astro';
import CoachingSection from '../components/CoachingSection.astro';
import CoachingTermsSection from '../components/CoachingTermsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impact Developer Programm - 1:1 Coaching mit Gregor Woiwode"
  description="12 Wochen 1:1 Mentoring und Coaching für Entwickler:innen auf dem Weg zu 100.000 Euro Gehalt oder 200.000 Euro Freelance-Umsatz: technische Tiefe, Produktkontext und Soft Skills."
>
  <Header ctaLabel="Kennenlerngespräch buchen" ctaHref="/kontakt" />
  <main id="main-content" class="pt-16">
    <CoachingHeroSection />
    <CoachingPathsSection />
    <CoachingFieldsSection />
    <CoachingSection />
    <TestimonialsSection />
    <CoachingTermsSection />
    <CoachingContactCTA />
    <FaqSection />
    <CoachingContactCTA id="coaching-contact-faq" />
  </main>
  <Footer />
</Layout>
