---
import { Image } from 'astro:assets';
import Logo from '../assets/logo.svg';
---

<footer class="bg-ink text-ink-faint py-16 sm:py-20">
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10 md:gap-6">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4" aria-label="Entwicklungszeit Home">
          <Image src={Logo} alt="" class="h-7 w-auto opacity-90" />
          <span class="font-serif italic text-xl text-paper">Entwicklungszeit</span>
        </a>
        <p class="text-sm leading-relaxed">
          Podcast &amp; Blog für Softwareentwicklung, Führung und Kommunikation.
        </p>
      </div>

      <div class="flex gap-16 sm:gap-24">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint/70 mb-4">
            Social
          </p>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a
                href="https://www.linkedin.com/in/gregor-woiwode/"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper transition-colors duration-300"
              >
                LinkedIn
              </a>
            </li>
            <li>
              <a
                href="https://github.com/GregOnNet"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper transition-colors duration-300"
              >
                GitHub
              </a>
            </li>
            <li>
              <a
                href="https://www.youtube.com/@entwicklungszeit"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper transition-colors duration-300"
              >
                YouTube
              </a>
            </li>
          </ul>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint/70 mb-4">
            Rechtliches
          </p>
          <ul class="space-y-2.5 text-sm">
            <li>
              <a href="/impressum" class="hover:text-paper transition-colors duration-300" data-astro-prefetch>
                Impressum
              </a>
            </li>
            <li>
              <a href="/datenschutz" class="hover:text-paper transition-colors duration-300" data-astro-prefetch>
                Datenschutz
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-ink-faint/20 text-sm">
      <p>&copy; {new Date().getFullYear()} Entwicklungszeit. Alle Rechte vorbehalten.</p>
    </div>
  </div>
</footer>
