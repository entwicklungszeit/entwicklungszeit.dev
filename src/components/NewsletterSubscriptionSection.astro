---
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  title?: string;
  id?: string;
}

const { title = 'Newsletter', id = 'newsletter' } = Astro.props;
---

<section class="bg-ink py-16 sm:py-20" id={id}>
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="max-w-2xl mx-auto">
      <NewsletterForm />
    </div>
  </div>
</section>
