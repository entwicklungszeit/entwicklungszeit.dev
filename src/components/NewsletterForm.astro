---
// Brevo form component, styled for the dark editorial newsletter box.
---

<style is:global>
  #sib-container input:-ms-input-placeholder {
    text-align: left;
    font-family: Inter, sans-serif;
    color: rgba(250, 248, 244, 0.5);
  }

  #sib-container input::placeholder {
    text-align: left;
    font-family: Inter, sans-serif;
    color: rgba(250, 248, 244, 0.5);
  }

  #sib-container a {
    text-decoration: underline;
    color: #faf8f4;
    font-weight: 500;
  }

  #sib-container a:hover {
    color: #8a8f9c;
  }

  #sib-container input[type='text'],
  #sib-container input[type='email'] {
    font-family: Inter, sans-serif;
    transition: all 0.3s ease;
  }
</style>

<link
  rel="stylesheet"
  href="https://sibforms.com/forms/end-form/build/sib-styles.css"
/>

<div id="sib-form-container" class="sib-form-container w-full">
  <!-- Error Message Panel -->
  <div
    id="error-message"
    class="sib-form-message-panel hidden mb-6 p-5 bg-red-500/10 border border-red-400/40 rounded-sm text-red-200"
  >
    <div class="flex items-start gap-4">
      <svg viewBox="0 0 512 512" class="sib-icon flex-shrink-0 w-6 h-6 mt-0.5">
        <path
          d="M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z"
        ></path>
      </svg>
      <span class="sib-form-message-panel__inner-text text-sm sm:text-base">
        Ups - Bei der Registrierung ist etwas schief gelaufen. Bitte versuche
        es erneut.
      </span>
    </div>
  </div>

  <!-- Success Message Panel -->
  <div
    id="success-message"
    class="sib-form-message-panel hidden mb-6 p-5 bg-emerald-500/10 border border-emerald-400/40 rounded-sm text-emerald-200"
  >
    <div class="flex items-start gap-4">
      <svg viewBox="0 0 512 512" class="sib-icon flex-shrink-0 w-6 h-6 mt-0.5">
        <path
          d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z"
        ></path>
      </svg>
      <span class="sib-form-message-panel__inner-text text-sm sm:text-base">
        Danke! Du hast dich erfolgreich für den Newsletter registriert!
      </span>
    </div>
  </div>

  <!-- Main Form Container -->
  <div id="sib-container" class="sib-container--large sib-container--vertical">
    <form
      id="sib-form"
      method="POST"
      action="https://d032b7de.sibforms.com/serve/MUIFAIyIV_2enmeym0Q9rNRG9FmderUgMxMZAXMfbySo8DumQ8IWKSuLLR4FDumO1_QblC89b9pxcqZb4kjf5TbZecBWhGQaGG4GgVkauJ9Qn9OrzmgtYoXyXqsn7sY633mP6HJGdZWgqIvN5lJ2lXLV1wHI6J3spcnsECBY2KFFPa8ylBXT7I8mWWInV3CuIMQ0B17IgO95v6gZSg=="
      data-type="subscription"
    >
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between lg:gap-16">
        <!-- Form Title -->
        <div class="mb-8 lg:mb-0 lg:max-w-md">
          <h3 class="font-serif text-3xl sm:text-4xl font-normal text-paper leading-tight mb-3">
            Neue Artikel &amp; Folgen per Mail
          </h3>
          <p class="text-base leading-relaxed text-paper/70">
            Kein Sales-Funnel, kein Countdown. Nur eine Mail, wenn es wirklich
            etwas Neues gibt.
          </p>
        </div>

        <div class="lg:w-full lg:max-w-md">
          <!-- Email Input Field -->
          <div class="sib-input sib-form-block">
            <div class="form__entry entry_block">
              <label class="sr-only" for="EMAIL">
                Gib hier deine E-Mail-Adresse ein
              </label>
              <div class="entry__field flex flex-col sm:flex-row gap-3">
                <input
                  class="input w-full sm:flex-1 px-4 py-3 bg-transparent border border-paper/25 rounded-sm text-paper placeholder-paper/50 focus:ring-2 focus:ring-paper/60 focus:border-paper/60 focus:outline-none transition-colors duration-300"
                  type="text"
                  id="EMAIL"
                  name="EMAIL"
                  autocomplete="email"
                  placeholder="deine@email.de"
                  data-required="true"
                  required
                />
                <button
                  type="submit"
                  class="sib-form-block__button sib-form-block__button-with-loader inline-flex items-center justify-center gap-2 px-6 py-3 bg-paper text-ink font-semibold rounded-sm hover:bg-paper/90 transition-colors duration-300 flex-shrink-0"
                  aria-label="Newsletter abonnieren"
                >
                  <svg
                    class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon inline-block w-4 h-4"
                    viewBox="0 0 512 512"
                  >
                    <path
                      d="M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261.028 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z"
                      fill="currentColor"></path>
                  </svg>
                  <span>Abonnieren</span>
                </button>
              </div>
              <label
                class="entry__error entry__error--primary hidden mt-2 text-sm text-red-300 font-medium"
              >
              </label>
            </div>
          </div>

          <!-- Consent Checkbox -->
          <div class="sib-optin sib-form-block mt-4" data-required="true">
            <div class="form__entry entry_mcq">
              <div class="form__label-row">
                <div class="entry__choice">
                  <label class="flex items-start gap-3 cursor-pointer group">
                    <input
                      type="checkbox"
                      class="input_replaced w-4 h-4 mt-1 border border-paper/40 rounded bg-transparent transition-colors duration-300 focus:ring-2 focus:ring-paper/60 cursor-pointer"
                      value="1"
                      id="OPT_IN"
                      name="OPT_IN"
                      required
                    />
                    <span class="text-sm text-paper/70 leading-relaxed">
                      Ich bin damit einverstanden, diesen Newsletter zu erhalten,
                      und akzeptiere die
                      <a href="/datenschutz" class="text-paper font-medium hover:text-paper/70 transition-colors"
                        >Datenschutzerklärung</a
                      >.
                    </span>
                  </label>
                </div>
              </div>
              <label
                class="entry__error entry__error--primary hidden mt-2 text-sm text-red-300 font-medium"
              >
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Privacy Declaration -->
      <p class="sib-form__declaration text-xs text-paper/40 leading-relaxed mt-10 pt-6 border-t border-paper/10">
        Wir nutzen Brevo als unsere Marketingplattform. Mit dem Absenden
        dieses Formulars erklären Sie sich damit einverstanden, dass die
        von Ihnen angegebenen personenbezogenen Daten zur Verarbeitung
        gemäß
        <a
          target="_blank"
          href="https://www.brevo.com/en/legal/privacypolicy/"
          class="text-paper/60 font-medium hover:text-paper transition-colors"
          rel="noopener noreferrer">Brevo's Privacy Policy.</a
        >
      </p>

      <input type="text" name="email_address_check" value="" class="hidden" />
      <input type="hidden" name="locale" value="en" />
    </form>
  </div>
</div>

<script defer src="https://sibforms.com/forms/end-form/build/main.js"></script>

<script>
  (window as any).REQUIRED_CODE_ERROR_MESSAGE = 'Please choose a country code';
  (window as any).LOCALE = 'en';
  (window as any).EMAIL_INVALID_MESSAGE = (window as any).SMS_INVALID_MESSAGE =
    'Leider enthalten die angegebenen Information Fehler. Bitte prüfe deine Eingaben und versuche es erneut.';
  (window as any).REQUIRED_ERROR_MESSAGE = 'Bitte fülle das Pflichtfeld aus.';
  (window as any).GENERIC_INVALID_MESSAGE =
    'Leider enthalten die angegebenen Information Fehler. Bitte prüfe deine Eingaben und versuche es erneut.';

  (window as any).translation = {
    common: {
      selectedList: '{quantity} list selected',
      selectedLists: '{quantity} lists selected',
      selectedOption: '{quantity} selected',
      selectedOptions: '{quantity} selected'
    }
  };

  var AUTOHIDE = Boolean(0);
</script>
