---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="flex flex-wrap items-center justify-between gap-6 mb-8 sm:mb-10">
  <div class="flex items-center gap-4 sm:gap-5">
    <div
      class="w-14 h-14 sm:w-16 sm:h-16 rounded-[18px] bg-primary text-white flex items-center justify-center flex-none shadow-[0_8px_24px_rgba(30,58,138,0.28)]"
    >
      <slot name="icon" />
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary mb-2">{eyebrow}</p>
      <h2 class="font-serif text-3xl sm:text-[34px] font-normal text-ink">{title}</h2>
    </div>
  </div>
  {
    Astro.slots.has('default') && (
      <div class="flex items-center gap-6">
        <slot />
      </div>
    )
  }
</div>
