---
import Heading from './Heading.astro';
import Section from './ui/Section.astro';

const pillars = [
  {
    title: 'Kommunikation',
    description:
      'Klar bleiben, wenn es schwierig wird – im Team, mit Stakeholdern und in Konflikten.'
  },
  {
    title: 'Führung',
    description:
      'Vom starken Entwickler zur technischen Führungskraft, die fachlich und menschlich überzeugt.'
  },
  {
    title: 'AI-Wandel',
    description:
      'Wie KI-Tools die Softwareentwicklung heute wirklich verändern – jenseits des Hypes.'
  },
  {
    title: 'Dev-Community',
    description:
      'Wissen teilen und voneinander lernen, statt Entwicklung als Einzelkampf zu begreifen.'
  }
];
---

<Section id="positioning" background="gradient">
  <div class="max-w-5xl mx-auto text-center">
    <Heading title="Worum es hier geht" />
    <p class="text-lg sm:text-xl text-gray-700 max-w-3xl mx-auto mb-4 leading-relaxed">
      Ich bin Gregor Woiwode – <strong>Google Developer Expert für Angular &amp;
      Web-Technologies</strong>, Podcaster und seit vielen Jahren in der
      Software-Community als Speaker und Workshop-Leiter unterwegs.
      "Entwicklungszeit" ist der Ort, an dem ich teile, was ich über
      Softwareentwicklung, Führung und Kommunikation gelernt habe – für
      Entwickler und Tech Leads, die die Branche im Wandel mitgestalten
      wollen.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12 text-left">
      {
        pillars.map(pillar => (
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{pillar.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{pillar.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
