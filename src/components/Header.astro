---
import { Image } from 'astro:assets';
import Logo from '../assets/logo.svg';
import Navigation from './Navigation.vue';

interface Props {
  ctaLabel?: string;
  ctaHref?: string;
}

const { ctaLabel, ctaHref } = Astro.props;
---

<header
  id="main-header"
  class="fixed w-full bg-paper/95 backdrop-blur-sm border-b border-rule z-50 top-0"
>
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="flex h-16 items-center justify-between w-full gap-6">
      <div class="flex items-center flex-shrink-0">
        <a
          href="/"
          class="flex items-center gap-2.5"
          aria-label="Entwicklungszeit Home"
        >
          <Image
            src={Logo}
            alt=""
            class="h-7 sm:h-8 w-auto"
            loading="eager"
          />
          <span class="font-serif italic text-xl sm:text-2xl text-ink">Entwicklungszeit</span>
        </a>
      </div>

      <Navigation client:load currentPath={Astro.url.pathname} />

      {
        ctaLabel && ctaHref && (
          <a
            href={ctaHref}
            class="hidden sm:inline-flex flex-shrink-0 items-center justify-center px-5 py-2 bg-ink text-paper text-sm font-semibold rounded-sm hover:bg-ink/90 transition-colors duration-300"
          >
            {ctaLabel}
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header?.classList.add('shadow-md');
      } else {
        header?.classList.remove('shadow-md');
      }
    });
  });
</script>
