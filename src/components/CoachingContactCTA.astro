---
// Calm, low-pressure contact link for the coaching page.
// Deliberately no countdown/urgency element and no multi-step sales form.
import { discoveryCallUrl } from '../data/coaching';

interface Props {
  id?: string;
}

const { id = 'coaching-contact' } = Astro.props;
---

<section id={id} class="bg-paper-raised border-y border-rule py-16 sm:py-24">
  <div class="max-w-reading mx-auto px-6 sm:px-10 text-center">
    <h2 class="font-serif text-3xl sm:text-4xl font-normal text-ink mb-4">
      Passt das zu dir?
    </h2>
    <p class="text-lg leading-relaxed text-ink-soft mb-8">
      Im Kennenlerngespräch nehmen wir uns 60 bis 90 Minuten Zeit. Ich höre dir zu, sage
      dir ehrlich, ob und wie ich dir helfen kann, und gebe dir erste Empfehlungen mit.
      Ganz unabhängig davon, ob wir danach zusammenarbeiten.
    </p>
    <a
      href={discoveryCallUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center px-8 py-3 bg-ink text-paper font-semibold rounded-sm hover:bg-ink/90 transition-colors duration-300"
    >
      Kennenlerngespräch anfragen
    </a>
  </div>
</section>
