---
import { programSteps, sessionFormat } from '../data/coaching';
---

<section id="ablauf" class="bg-paper py-16 sm:py-24">
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="mb-16">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-3">
        So läuft es ab
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-ink mb-4">
        Vom Kennenlerngespräch bis zur Bilanz
      </h2>
      <p class="text-lg leading-relaxed text-ink-soft max-w-[62ch]">
        Zwölf Wochen 1:1, mit einem festen Rahmen und Raum für das, was bei dir gerade
        dran ist.
      </p>
    </div>

    <ol class="border-t border-rule mb-20">
      {
        programSteps.map(step => (
          <li class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 py-6 border-b border-rule">
            <span class="text-xs font-semibold uppercase tracking-[0.1em] text-primary sm:w-28 flex-shrink-0">
              {step.week}
            </span>
            <div>
              <h3 class="font-serif text-xl font-normal text-ink mb-1.5">{step.title}</h3>
              <p class="text-sm leading-relaxed text-ink-soft max-w-[62ch]">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <h3 class="font-serif text-2xl font-normal text-ink mb-8">So läuft eine Session</h3>
    <div class="grid md:grid-cols-3 gap-x-10 gap-y-10">
      {
        sessionFormat.map(item => (
          <div class="border-t border-rule pt-5">
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-primary mb-3">
              {item.title}
            </p>
            <p class="text-sm text-ink-soft leading-relaxed">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
