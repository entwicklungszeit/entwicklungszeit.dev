---
import { coachingBenefits, programSteps } from '../data/coaching';
---

<section id="coaching" class="bg-paper py-16 sm:py-24">
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="mb-16">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-3">
        Impact Developer – Dein Tech Lead Coach für Engineering Excellence
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-ink mb-4">
        Software Coaching &amp; Mentoring
      </h2>
      <p class="text-lg leading-relaxed text-ink-soft max-w-[62ch]">
        Entwickle dich zum technischen Leader, der sowohl fachlich als auch menschlich
        überzeugt. Ein maßgeschneidertes 1:1 Software Coaching Format, das dich auf die
        nächste Stufe deiner Karriere als Tech Lead bringt.
      </p>
    </div>

    <h3 class="font-serif text-2xl font-normal text-ink mb-8">
      Coaching-Programm: Von Developer zum Tech Lead
    </h3>

    <ol class="border-t border-rule mb-20">
      {
        programSteps.map(step => (
          <li class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 py-6 border-b border-rule">
            <span class="text-xs font-semibold uppercase tracking-[0.1em] text-primary sm:w-28 flex-shrink-0">
              {step.week}
            </span>
            <div>
              <h4 class="font-serif text-xl font-normal text-ink mb-1.5">{step.title}</h4>
              <p class="text-sm leading-relaxed text-ink-soft">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
      {
        Object.entries(coachingBenefits).map(([category, items]) => (
          <div class="border-t border-rule pt-5">
            <p class="text-xs font-semibold uppercase tracking-[0.1em] text-primary mb-4">
              {category}
            </p>
            <ul class="space-y-2.5">
              {items.map(item => (
                <li class="text-sm text-ink-soft leading-relaxed">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
