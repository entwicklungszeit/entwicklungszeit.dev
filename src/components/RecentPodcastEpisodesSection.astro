---
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/formatDate';

const episodes = (await getCollection('podcast'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section id="recent-episodes" class="bg-paper-raised border-y border-rule py-16 sm:py-20">
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-2">
          Podcast
        </p>
        <h2 class="font-serif text-3xl sm:text-[34px] font-normal text-ink">Neueste Folgen</h2>
      </div>
      <a
        href="/podcast"
        class="text-sm font-semibold text-primary hover:text-secondary transition-colors duration-300"
      >
        Alle Folgen →
      </a>
    </div>

    {
      episodes.length === 0 ? (
        <p class="text-ink-soft">Noch keine Episoden veröffentlicht.</p>
      ) : (
        <div class="border-t border-rule">
          {episodes.map(episode => (
            <a
              href={`/podcast/${episode.id}`}
              class="flex items-baseline gap-5 sm:gap-7 py-5 sm:py-6 border-b border-rule group"
            >
              <span class="font-serif text-2xl sm:text-3xl text-ink-faint w-10 sm:w-12 flex-shrink-0">
                {String(episode.data.episodeNumber).padStart(2, '0')}
              </span>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif text-lg sm:text-xl font-normal text-ink mb-1 group-hover:text-primary transition-colors duration-300">
                  {episode.data.title}
                </h3>
                <time datetime={episode.data.pubDate.toISOString()} class="text-xs sm:text-sm text-ink-soft">
                  {formatDate(episode.data.pubDate)}
                </time>
              </div>
              <span class="hidden sm:inline text-sm font-semibold text-primary flex-shrink-0">
                Shownotes →
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
