---
import { Image } from 'astro:assets';
import portrait from '../assets/gregor-woiwode.png';
import { books } from '../data/books';
import { hostStats } from '../data/host';
import OfferIcon from './OfferIcon.astro';
---

<section class="bg-paper pt-12 pb-16 sm:pt-20 sm:pb-24">
  <div
    class="max-w-wrap mx-auto px-6 sm:px-10 grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16 lg:items-center"
  >
    <div>
      <p
        class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5"
      >
        Podcast · Blog
      </p>
      <h1
        class="font-serif text-4xl sm:text-5xl lg:text-[68px] font-normal leading-[1.1] lg:leading-[1.06] tracking-tight text-ink mb-7 max-w-[16ch]"
      >
        Bessere Software entsteht, wenn Teams verstehen, <em
          class="italic text-highlight-ink">warum</em
        > sie tun, was sie tun.
      </h1>
      <p class="text-lg leading-relaxed text-ink-soft max-w-[52ch]">
        Entwicklungszeit ist Podcast und Blog für Entwickler und Tech Leads, die
        Softwareentwicklung als Teamsport verstehen – mit Themen zu
        Kommunikation, Führung und dem KI-Wandel der Branche.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/podcast"
          class="inline-flex items-center gap-3 px-6 py-3 bg-ink text-paper font-semibold rounded-sm border border-ink hover:bg-ink/90 transition-colors duration-300"
        >
          <OfferIcon
            offer="podcast"
            size={24}
            class="[--offer-accent-override:#f4a06b]"
          />
          Podcast hören
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-3 px-6 py-3 text-ink font-semibold rounded-sm border border-ink hover:bg-ink/5 transition-colors duration-300"
        >
          <OfferIcon offer="blog" size={24} />
          Blog lesen
        </a>
      </div>
    </div>
    <figure
      class="relative m-0 w-[300px] h-[370px] justify-self-center lg:w-[400px] lg:h-auto lg:justify-self-end"
    >
      <div class="w-[400px] origin-top-left scale-75 lg:scale-100">
        <div class="relative w-[400px] h-[380px]">
          <svg
            class="absolute left-0 top-[10px] overflow-visible text-highlight"
            width="400"
            height="400"
            viewBox="0 0 400 400"
            aria-hidden="true"
          >
            <circle cx="200" cy="200" r="150" fill="#FBEDE3"></circle>
            <circle
              cx="200"
              cy="200"
              r="150"
              fill="none"
              stroke="currentColor"
              opacity=".3"></circle>
            <circle
              cx="200"
              cy="200"
              r="178"
              fill="none"
              stroke="currentColor"
              opacity=".2"></circle>
            <circle
              cx="200"
              cy="200"
              r="206"
              fill="none"
              stroke="currentColor"
              opacity=".12"></circle>
          </svg>
          <div
            class="absolute left-[50px] top-0 w-[300px] h-[360px] overflow-hidden rounded-b-[150px]"
          >
            <Image
              src={portrait}
              alt="Portrait von Gregor Woiwode"
              width={600}
              loading="eager"
              class="absolute bottom-0 left-0 w-[300px] h-auto"
            />
          </div>
          <div
            class="absolute -left-2 top-[300px] flex items-center gap-2.5 rounded-full border border-rule bg-white py-2 pl-2.5 pr-4 shadow-[0_10px_24px_-14px_rgba(21,24,31,.35)]"
          >
            <span
              class="flex size-[30px] items-center justify-center rounded-full bg-highlight-tint"
            >
              <OfferIcon offer="podcast" size={18} />
            </span>
            <span class="text-[13px] font-semibold text-ink whitespace-nowrap"
              >Host von Entwicklungszeit</span
            >
          </div>
        </div>
        <figcaption class="mt-[22px] pl-[62px]">
          <div class="mb-3 h-0.5 w-7 bg-highlight"></div>
          <div class="font-serif text-[26px] leading-tight text-ink">
            Gregor Woiwode
          </div>
          <div class="mt-1 text-[13px] text-ink-soft">
            Software Engineer &amp; CIO
          </div>
        </figcaption>
      </div>
    </figure>
  </div>
  <div class="max-w-wrap mx-auto px-6 sm:px-10 mt-16 sm:mt-20">
    <div
      class="grid gap-8 border-t border-rule pt-8 sm:grid-cols-2 lg:grid-cols-4"
    >
      <a
        href="/buecher"
        class="group block rounded-sm focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[6px] focus-visible:outline-primary-light"
      >
        <div class="flex items-center gap-3.5">
          <span class="font-serif text-4xl text-primary leading-none"
            >{books.length}</span
          >
          <svg
            class="text-primary transition-transform group-hover:translate-x-1"
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 10h12M11 5l5 5-5 5"></path>
          </svg>
        </div>
        <div
          class="text-sm text-ink-soft mt-1.5 group-hover:text-primary group-hover:underline underline-offset-4"
        >
          Fachbücher geschrieben – jetzt ansehen
        </div>
      </a>
      {
        hostStats.map(stat => (
          <div>
            <div class="font-serif text-4xl text-highlight-ink leading-none">
              {stat.value}
            </div>
            <div class="text-sm text-ink-soft mt-1.5">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
