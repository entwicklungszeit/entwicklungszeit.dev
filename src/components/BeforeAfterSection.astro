---
const transformationItems = [
  {
    category: 'Softwareentwicklung',
    before: [
      'Komplexe technische Herausforderungen überfordern dich',
      'Arbeiten an Code-Problemen erfolgt isoliert',
      'Du kannst technische Konzepte nicht klar erklären',
      'Unsicherheit bei architektonischen Entscheidungen'
    ],
    after: [
      'Du löst komplexe Probleme mit systematischen Ansätzen',
      'Du schaffst kollaborative Entwicklungsumgebungen',
      'Du kommunizierst technische Konzepte klar und verständlich',
      'Du triffst selbstbewusst fundierte Architekturentscheidungen'
    ]
  },
  {
    category: 'Kommunikation & Führung',
    before: [
      'Schwierige Gespräche werden vermieden',
      'Ideen werden nicht klar ausgedrückt',
      'Unsicherheit bei der Führung technischer Entscheidungen',
      'Schwierigkeiten bei der Delegation und im Vertrauen auf andere'
    ],
    after: [
      'Du meisterst herausfordernde Diskussionen souverän',
      'Du artikulierst Ideen mit Selbstvertrauen und Klarheit',
      'Du führst Teams selbstsicher durch technische Herausforderungen',
      'Du stärkst Teammitglieder durch effektive Delegation'
    ]
  }
];
---

<section id="transformation" class="bg-paper-raised border-y border-rule py-16 sm:py-24">
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="mb-14">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-3">
        Der Weg zum Impact Developer
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-ink mb-4">
        Du machst den Unterschied
      </h2>
      <p class="text-lg leading-relaxed text-ink-soft max-w-[62ch]">
        Geh technisch noch tiefer und kombiniere deine Expertise mit Kommunikations- und
        Führungsfähigkeiten. Präge die Strategie deiner Kunden oder deines Unternehmens.
      </p>
    </div>

    <div class="space-y-12">
      {
        transformationItems.map(item => (
          <div class="border-t border-rule pt-8">
            <h3 class="font-serif text-2xl font-normal text-ink mb-6">{item.category}</h3>
            <div class="grid md:grid-cols-2 gap-8">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-faint mb-4">
                  Vorher
                </p>
                <ul class="space-y-3">
                  {item.before.map(point => (
                    <li class="text-sm text-ink-soft leading-relaxed pl-4 border-l border-rule">
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.1em] text-primary mb-4">
                  Nachher
                </p>
                <ul class="space-y-3">
                  {item.after.map(point => (
                    <li class="text-sm text-ink leading-relaxed pl-4 border-l-2 border-primary">
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
