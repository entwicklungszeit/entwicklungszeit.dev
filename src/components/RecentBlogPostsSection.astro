---
import { getCollection } from 'astro:content';
import Heading from './Heading.astro';
import Section from './ui/Section.astro';
import { blogCategoryLabels } from '../data/blogCategories';
import { formatDate } from '../lib/formatDate';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Section id="recent-posts" background="white">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
      <Heading title="Neueste Artikel" />
      <a
        href="/blog"
        class="text-primary font-medium hover:text-secondary transition-colors duration-300"
      >
        Alle Artikel →
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-gray-500">Noch keine Artikel veröffentlicht.</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map(post => (
            <a
              href={`/blog/${post.id}`}
              class="bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-300 p-6 flex flex-col"
            >
              <span class="inline-block self-start px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary mb-4">
                {blogCategoryLabels[post.data.category]}
              </span>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">{post.data.title}</h3>
              <p class="text-sm text-gray-600 mb-4 flex-1">{post.data.description}</p>
              <time datetime={post.data.pubDate.toISOString()} class="text-xs text-gray-400">
                {formatDate(post.data.pubDate)}
              </time>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Section>
