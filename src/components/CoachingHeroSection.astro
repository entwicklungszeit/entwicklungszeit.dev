---
const pillars = [
  {
    label: 'Technisch',
    title: 'Architektur & Code, der trägt',
    description:
      'Saubere Architekturentscheidungen, Code-Reviews auf Senior-Niveau und der Blick für technische Schulden, bevor sie zum Problem werden.'
  },
  {
    label: 'Strategisch',
    title: 'Wirkung & Führung',
    description:
      'Wie du Vertrauen aufbaust, Entscheidungen triffst, wenn nicht alle Informationen vorliegen, und dein technisches Urteilsvermögen sichtbar machst.'
  }
];
---

<section class="bg-paper pt-12 pb-16 sm:pt-20 sm:pb-24">
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-5">
      1:1 Coaching
    </p>
    <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.1] text-ink mb-7 max-w-[18ch]">
      Für Entwickler auf dem Weg zu 80.000&ndash;200.000&nbsp;&euro; Jahresgehalt.
    </h1>
    <p class="text-lg leading-relaxed text-ink-soft max-w-[62ch] mb-16">
      Technische Tiefe allein reicht ab einem gewissen Punkt nicht mehr. Ich begleite
      Entwickler:innen dabei, technisches Können mit strategischem Denken und
      Führungsfähigkeit zu verbinden – ohne dabei die Substanz zu verlieren, die sie
      überhaupt erst dahin gebracht hat.
    </p>

    <div class="grid gap-10 sm:grid-cols-2 border-t border-rule pt-10">
      {
        pillars.map(pillar => (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary mb-3">
              {pillar.label}
            </p>
            <h2 class="font-serif text-2xl font-normal text-ink mb-3">{pillar.title}</h2>
            <p class="text-sm leading-relaxed text-ink-soft">{pillar.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
