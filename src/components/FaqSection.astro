---
import { faqs } from '../data/faqData';
import Accordion from './ui/Accordion.vue';
---

<section id="faq" class="bg-paper py-16 sm:py-24">
  <div class="max-w-wrap mx-auto px-6 sm:px-10">
    <div class="mb-12">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-faint mb-3">
        Häufige Fragen
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-ink mb-4">
        Häufig gestellte Fragen
      </h2>
      <p class="text-lg leading-relaxed text-ink-soft max-w-[62ch]">
        Hier findest du Antworten auf die häufigsten Fragen zum Impact Developer-Programm.
      </p>
    </div>

    <Accordion client:visible items={faqs} />
  </div>
</section>
